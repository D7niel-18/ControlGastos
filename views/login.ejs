<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Iniciar sesión | Control de gastos</title>
    <link rel="stylesheet" href="/css/login.css">
    <link rel="stylesheet" href="/css/global.css">
</head>
<body>
    <main class="login-container">

        <!-- Panel de presentación -->
        <section class="login-info">
            <div class="brand">
                <span class="brand-icon">€</span>
                <span>Controla</span>
            </div>

            <div class="info-content">
                <p class="eyebrow">TOMA EL CONTROL</p>

                <h1>Tus finanzas,<br>
                    <span>bajo control.</span>
                </h1>

                <p class="info-description">
                    Gestiona tus ingresos y gastos, controla tu saldo
                    y descubre en qué utilizas tu dinero.
                </p>

                <div class="feature">
                    <span class="feature-icon">✓</span>
                    <span>Todos tus movimientos en un solo lugar</span>
                </div>

                <div class="feature">
                    <span class="feature-icon">✓</span>
                    <span>Control sencillo de tus gastos personales</span>
                </div>
            </div>

            <p class="info-footer">Organiza tu dinero. Decide mejor.</p>
        </section>

        <!-- Panel del formulario -->
        <section class="login-form-panel">
            <div class="login-form-wrapper">

                <div class="mobile-brand">
                    <span class="brand-icon">€</span>
                    <span>Controla</span>
                </div>

                <p class="welcome">BIENVENIDO DE NUEVO</p>
                <h2>Iniciar sesión</h2>
                <p class="form-description">
                    Introduce tus datos para acceder a tu cuenta.
                </p>

                <% if (typeof error !== 'undefined' && error) { %>
                    <p class="error-message" role="alert"><%= error %></p>
                <% } %>

                <form action="/login" method="POST">
                    <div class="form-group">
                        <label for="email">Correo electrónico</label>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder="tu@correo.com"
                            autocomplete="email"
                            required
                        >
                    </div>

                    <div class="form-group">
                        <label for="password">Contraseña</label>
                        <input
                            type="password"
                            id="password"
                            name="password"
                            placeholder="Introduce tu contraseña"
                            autocomplete="current-password"
                            required
                        >
                    </div>

                    <button type="submit" class="login-button">
                        Iniciar sesión
                        <span aria-hidden="true">→</span>
                    </button>
                </form>

                <p class="register-link">
                    ¿Todavía no tienes cuenta?
                    <a href="/registro">Crear una cuenta</a>
                </p>

            </div>
        </section>

    </main>
</body>
</html>